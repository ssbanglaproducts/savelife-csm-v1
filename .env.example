# Local database published by docker-compose on port 5433.
POSTGRES_USER=savelife
# Required by docker-compose. Use a strong unique value outside local development.
POSTGRES_PASSWORD=savelife
POSTGRES_DB=savelife
POSTGRES_PORT=5433
DATABASE_URL="postgresql://savelife:savelife@localhost:5433/savelife?schema=public"

# Auth.js. Generate a strong random value before deploying. The exact value
# below is a known placeholder and is rejected when NODE_ENV=production.
AUTH_SECRET="replace-with-a-long-random-secret"
# Canonical public origin. Set this to the HTTPS domain in production.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Trust the Host header only for an intentional local setup. Leave false in production.
AUTH_TRUST_HOST=false
# Emergency opt-out for a local-only production build with a stand-in secret.
# ALLOW_DEV_SECRET=1

# Optional dedicated HMAC key for signup invite links; falls back to AUTH_SECRET.
# SIGNUP_INVITE_SECRET="replace-with-a-long-random-secret"

# Required when running `npm run db:seed` with NODE_ENV=production.
# SEED_ADMIN_PASSWORD="generate-a-long-random-admin-password"
# SEED_FOUNDER_PASSWORD="generate-a-long-random-founder-password"

# Uploaded rank art, profile images and gallery images.
UPLOAD_DIR="./uploads"

# Optional secrets for external schedulers. The app also runs both automation
# passes in-process every five minutes on an always-on Node server.
INVESTMENT_AUTOMATION_SECRET="replace-with-a-long-random-secret"
SALARY_AUTOMATION_SECRET="replace-with-a-long-random-secret"

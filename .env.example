# Local database published by docker-compose on port 5433.
POSTGRES_USER=savelife
POSTGRES_PASSWORD=savelife
POSTGRES_DB=savelife
POSTGRES_PORT=5433
DATABASE_URL="postgresql://savelife:savelife@localhost:5433/savelife?schema=public"

# Auth.js. Generate a strong random value before deploying.
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional dedicated HMAC key for signup invite links; falls back to AUTH_SECRET.
# SIGNUP_INVITE_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Uploaded rank art, profile images and gallery images.
UPLOAD_DIR="./uploads"

# Optional secrets for external schedulers. The app also runs both automation
# passes in-process every five minutes on an always-on Node server.
INVESTMENT_AUTOMATION_SECRET="replace-with-a-long-random-secret"
SALARY_AUTOMATION_SECRET="replace-with-a-long-random-secret"
